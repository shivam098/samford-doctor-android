<?xml version="1.0" encoding="utf-8"?>
<!--
  Demo build: the mock backend may run on a tester's LAN over plain HTTP, and only synthetic
  data is ever used. A production build must remove cleartext and pin the hospital's HTTPS host.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
